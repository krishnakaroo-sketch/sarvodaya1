rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In this simple setup, any authenticated user is an admin 
      // (User must disable open registration in Firebase Console)
      return isSignedIn();
    }
    
    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /content_blocks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /institutions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /careers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /job_applications/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /inquiries/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
